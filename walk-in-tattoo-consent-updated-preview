<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Walk In Tattoo | Digital Consent</title><style>:root{font-family:system-ui,-apple-system,Arial;background:#f4f4f2;color:#171717}*{box-sizing:border-box}body{margin:0}.wrap{max-width:650px;margin:auto;padding:18px}header{background:#111;color:#fff;padding:22px;text-align:center}header h1{margin:0;letter-spacing:2px;font-size:23px}header small{color:#bbb}.card{background:#fff;border:1px solid #ddd;border-radius:14px;padding:22px;margin:16px 0;box-shadow:0 2px 9px #00000008}.banner{background:#fff3d7;border:1px solid #e7c77b;padding:12px;border-radius:10px;font-size:14px}h2{font-size:21px;margin:0 0 10px}h3{font-size:16px}p{line-height:1.5}label{display:block;font-weight:600;margin:14px 0 5px}input:not([type=checkbox]):not([type=radio]),textarea,select{width:100%;font:inherit;padding:12px;border:1px solid #bbb;border-radius:9px;background:#fff}textarea{min-height:80px}.choice{display:flex;gap:10px}.choice label{flex:1;border:1px solid #ccc;padding:12px;border-radius:9px;text-align:center;margin:0;cursor:pointer}.choice input{margin-right:6px}.q{border-bottom:1px solid #eee;padding:13px 0}.q p{font-weight:600;margin:0 0 9px}.check{display:flex;gap:10px;align-items:flex-start;margin:14px 0;font-weight:400}.check input{margin-top:5px}.muted{color:#666;font-size:13px}.actions{display:flex;gap:10px;margin-top:20px}button{font:inherit;padding:13px 17px;border-radius:9px;border:0;background:#111;color:white;font-weight:700;cursor:pointer;flex:1}button.secondary{background:#e9e9e9;color:#111}button:disabled{opacity:.4}.hide{display:none!important}canvas{width:100%;height:155px;border:1px solid #aaa;border-radius:9px;touch-action:none;background:white}progress{width:100%;accent-color:#111}.error{color:#a00000;font-weight:600}.fine{font-size:12px;color:#555}a{color:inherit}</style></head><body><header><h1>WALK IN TATTOO</h1><small>Digital Consent</small></header><main class="wrap"><div class="banner" id="statusBanner">Complete all four steps, then submit your consent form. Please ask staff if you have questions.</div><div class="card"><progress id="prog" max="4" value="1"></progress><p class="muted" id="stepLabel">Step 1 of 4</p><form id="form" novalidate><section id="s1"><h2>What are you here for?</h2><label for="service">Service</label><select id="service" required><option value="">Choose one</option><option value="Tattoo">Tattoo</option><option value="Piercing">Piercing</option></select><h3>Your information</h3><label for="fullName">Full legal name</label><input id="fullName" autocomplete="name" required><label for="dob">Date of birth</label><input id="dob" type="date" required><label class="check"><input id="under18" type="checkbox"><span>I am under 18 years old</span></label><p class="error hide" id="minor"></p><div id="guardianBlock" class="hide"><h3>Parent / legal guardian information</h3><p class="muted">For eligible minors only. Guardian must attend in person for staff identity verification and witnessed written consent before any procedure. Documents are submitted securely and verified by staff in person.</p><label for="guardianName">Parent/guardian full legal name</label><input id="guardianName"><label for="guardianRelation">Relationship to minor</label><input id="guardianRelation"><label for="guardianPhone">Parent/guardian phone</label><input id="guardianPhone" type="tel"><label for="guardianAddress">Parent/guardian street address</label><input id="guardianAddress"><label for="guardianWork">Parent/guardian place of work</label><input id="guardianWork"><label for="guardianIdType">Guardian ID type</label><select id="guardianIdType"><option value="">Choose one</option><option>Driver license</option><option>State ID</option><option>Passport</option><option>Other government photo ID</option></select><label for="guardianId">Guardian ID image</label><input id="guardianId" type="file" accept="image/*"><label for="relationshipDoc">Birth certificate / guardianship documentation (if requested)</label><input id="relationshipDoc" type="file" accept="image/*"><label class="check"><input id="guardianPresent" type="checkbox"><span>Guardian will appear in person with identification to sign consent in the presence of shop staff.</span></label></div><label for="phone">Mobile phone</label><input id="phone" type="tel" autocomplete="tel" placeholder="(208) 555-0123" required><label for="email">Email</label><input id="email" type="email" autocomplete="email" required><label for="address">Street address</label><input id="address" autocomplete="street-address" required><label for="detail">Tattoo design/location or piercing placement</label><input id="detail" required><p class="fine">Staff must verify identification before the procedure. Minor procedures require in-person guardian consent and staff verification. </p></section><section id="s2" class="hide"><h2>Health screening</h2><p class="muted">Answer honestly. A Yes answer does not necessarily prevent the procedure; staff may follow up privately.</p><div id="questions"></div><label for="notes">Please explain any Yes answers or other relevant health concerns</label><textarea id="notes"></textarea></section><section id="s3" class="hide"><h2>Review & consent</h2><div id="agreement"></div><label class="check"><input id="agree" type="checkbox" required><span>I have read the disclosures, had an opportunity to ask questions, and voluntarily consent to the selected procedure.</span></label><h3>Optional permissions</h3><p>Walk In Tattoo may photograph or record me, the procedure, completed work, and general activities or appearances in the shop for social media, advertisements, websites, printed materials, and other promotions. This includes photos and videos beyond completed work. No compensation is provided for approved promotional use. Declining does not affect service.</p><label class="check"><input type="radio" name="photoRelease" value="yes"><span>Yes, I authorize photography, video, and promotional use of my image and likeness.</span></label><label class="check"><input type="radio" name="photoRelease" value="no"><span>No, I do not authorize promotional use of my image or likeness.</span></label><div id="designAck" class="hide"><h3>Tattoo design and artistic interpretation</h3><p>I understand all tattoos are handmade and unique to the artist and client. Whether I bring a reference, select wall flash, or choose a Get What You Get design, the final tattoo may vary based on the artist’s interpretation, technique, and style. Exact duplication is not guaranteed.</p><p>For Get What You Get tattoos, I accept the design selected by the game. The artist chooses final colors, style, and artistic execution without client coordination over those creative choices.</p><label class="check"><input id="designAgree" type="checkbox"><span>I understand and accept the tattoo design and artistic interpretation terms.</span></label></div><div id="guardianConsent" class="hide"><h3>Minor customer — guardian consent</h3><p>A parent/legal guardian must be present to verify identification and sign written informed consent in front of shop staff. This online form is not a substitute for witnessed consent.</p><label class="check"><input id="guardianAck" type="checkbox"><span>I understand that in-person guardian consent and staff verification are required before the procedure.</span></label></div><label class="check"><input id="marketingEmail" type="checkbox"><span>I agree to receive promotional emails. I can unsubscribe at any time.</span></label></section><section id="s4" class="hide"><h2>Sign & review</h2><p>Sign using your finger or mouse.</p><canvas id="signature" width="900" height="310" aria-label="Signature drawing area"></canvas><button class="secondary" type="button" id="clear" style="margin-top:8px">Clear signature</button><label class="check"><input type="checkbox" id="signed" required><span>I confirm this is my signature and the information provided is accurate.</span></label><p class="muted">Submission time and form version will be recorded. Staff must verify identification and any required guardian documents in person.</p></section><p id="err" class="error" role="alert"></p><div class="actions"><button type="button" class="secondary hide" id="back">Back</button><button type="button" id="next">Continue</button></div></form></div></main><script>
const sharedQs=[
'Are you pregnant or currently nursing?',
'Do you have diabetes or another condition that may affect healing?',
'Do you have a bleeding disorder or take blood-thinning medication?',
'Do you have allergies or sensitivities to latex, adhesives, antiseptics, inks, pigments, or metals?',
'Do you have an immune-system condition or take medication that suppresses immunity?',
'Do you have a history of excessive scarring, keloids, fainting, or difficulty healing wounds?',
'Do you have a current infection, fever, rash, open wound, or skin irritation near the procedure area?',
'Are you currently taking any medication or receiving treatment that may affect bleeding, skin, or healing?',
'Have you consumed alcohol or impairing drugs today?',
'Is there any other health concern you would like to discuss privately with your artist or piercer?'
];
const tattooQs=[
'Have you previously had an allergic or unusual reaction to a tattoo or tattoo pigment?',
'Have you recently used topical numbing products, exfoliants, or skin treatments on the intended tattoo area?',
'Is the intended tattoo area sunburned, injured, or recently treated with a cosmetic procedure?'
];
const piercingQs=[
'Have you had a previous piercing migrate, reject, become infected, or heal unusually?',
'Do you have a known sensitivity to jewelry metals or a history of reactions to body jewelry?',
'Have you had surgery, implants, or other medical treatment affecting the intended piercing area?'
];
let qs=[];const questions=document.getElementById('questions');
function buildQuestions(){qs=[...sharedQs,...(document.getElementById('service').value==='Piercing'?piercingQs:tattooQs)];questions.replaceChildren();qs.forEach((q,i)=>{const d=document.createElement('div');d.className='q';const prompt=document.createElement('p');prompt.textContent=`${i+1}. ${q}`;d.appendChild(prompt);const choices=document.createElement('div');choices.className='choice';['Yes','No'].forEach(v=>{const label=document.createElement('label');const input=document.createElement('input');input.type='radio';input.name=`q${i}`;input.value=v;input.required=true;label.append(input,document.createTextNode(v));choices.appendChild(label)});d.appendChild(choices);questions.appendChild(d)})}
const tattooAgreement=[
['Procedure and permanence','I voluntarily request a tattoo and understand that it permanently changes my skin. Removal or alteration may be costly, painful, and incomplete.'],
['Potential complications','I understand risks including pain, bleeding, infection, allergic reactions, scarring, pigment migration, fading, and uneven healing.'],
['Design approval','Before the procedure begins, I will review and approve the design, spelling, size, placement, and orientation.'],
['Aftercare and healing','I will follow the aftercare instructions provided. Healing and final appearance vary by individual; no particular cosmetic result is guaranteed.'],
['Touch-ups and payment','I understand that touch-ups, if offered, follow the shop’s stated touch-up policy. Completed services are nonrefundable except where required by law.'],
['Safety and questions','I have had an opportunity to ask questions. The artist may decline or postpone a procedure for legitimate safety or professional reasons.']
];
const piercingAgreement=[
['Procedure and placement','I voluntarily request the specified piercing and will approve its location and initial jewelry before the procedure.'],
['Potential complications','I understand risks including pain, bleeding, infection, allergic reactions, swelling, scarring, migration, rejection, and injury to nearby tissue.'],
['Jewelry and anatomy','Initial jewelry is selected based on anatomy and healing needs. Downsizing or replacement may be recommended during healing.'],
['Aftercare and healing','I will follow the aftercare instructions provided. Healing times and results vary, and a piercing may close or leave a lasting mark.'],
['Payment','Completed piercing services are nonrefundable except where required by law.'],
['Safety and questions','I have had an opportunity to ask questions. The piercer may decline or postpone a procedure for legitimate safety, anatomical, or professional reasons.']
];
function buildAgreement(){$('designAck').classList.toggle('hide',$('service').value!=='Tattoo');$('guardianConsent').classList.toggle('hide',!isMinor());const a=document.getElementById('agreement');a.replaceChildren();const intro=document.createElement('p');intro.textContent='Please read each section before agreeing. Your signature confirms your informed consent to the procedure described.';a.appendChild(intro);for(const [heading,body] of (document.getElementById('service').value==='Piercing'?piercingAgreement:tattooAgreement)){const h=document.createElement('h3');h.textContent=heading;const p=document.createElement('p');p.textContent=body;a.append(h,p)}const note=document.createElement('p');note.className='fine';note.textContent='Please ask staff about any questions before signing.';a.appendChild(note)}
let step=1,hasInk=false;const $=id=>document.getElementById(id);function age(d){const b=new Date(d+'T12:00:00'),n=new Date();let a=n.getFullYear()-b.getFullYear();if(n.getMonth()<b.getMonth()||(n.getMonth()===b.getMonth()&&n.getDate()<b.getDate()))a--;return a}function isMinor(){return $('dob').value && age($('dob').value)<18}function updateMinor(){const minor=isMinor();$('under18').checked=!!minor;$('guardianBlock').classList.toggle('hide',!minor);const a=age($('dob').value),service=$('service').value;let msg='';if(minor && (a<14 || (service==='Tattoo'&&a<16)))msg=service==='Tattoo'?'Walk In Tattoo offers tattoos only to customers age 16 or older.':'Walk In Tattoo offers piercings only to customers age 14 or older.';$('minor').textContent=msg;$('minor').classList.toggle('hide',!msg)}$('dob').addEventListener('change',updateMinor);$('service').addEventListener('change',updateMinor);$('under18').addEventListener('change',()=>{if($('dob').value)updateMinor();else $('guardianBlock').classList.toggle('hide',!$('under18').checked)});function render(){for(let i=1;i<=4;i++)$('s'+i).classList.toggle('hide',i!==step);$('prog').value=step;$('stepLabel').textContent=`Step ${step} of 4`;$('back').classList.toggle('hide',step===1);$('next').textContent=step===4?'Submit consent':'Continue';$('err').textContent='';if(step===2 && questions.children.length===0)buildQuestions();if(step===3)buildAgreement();window.scrollTo(0,0)}function valid(){if(step===1){for(const id of ['service','fullName','dob','phone','email','address','detail']){if(!$(id).checkValidity()||!$(id).value.trim()){ $('err').textContent='Please complete all required fields with valid information.';$(id).focus();return false}}updateMinor();const a=age($('dob').value);if(a<14 || ($('service').value==='Tattoo'&&a<16)){$('err').textContent='This service is not offered for the selected age.';return false}if(isMinor()){for(const id of ['guardianName','guardianRelation','guardianPhone','guardianAddress','guardianWork','guardianIdType'])if(!$(id).value.trim()){$('err').textContent='Complete the parent/guardian details.';$(id).focus();return false}if(!$('guardianId').files.length){$('err').textContent='Please select a guardian ID document.';return false}if(!$('guardianPresent').checked){$('err').textContent='Guardian must attend in person.';return false}}}if(step===2){for(let i=0;i<qs.length;i++)if(!document.querySelector(`input[name=q${i}]:checked`)){$('err').textContent='Please answer every health screening question.';return false}}if(step===3){if(!$('agree').checked){$('err').textContent='Please read and accept the procedure consent.';return false}if(!document.querySelector('input[name=photoRelease]:checked')){$('err').textContent='Please select Yes or No for photo and video permission.';return false}if($('service').value==='Tattoo'&&!$('designAgree').checked){$('err').textContent='Please acknowledge the tattoo design terms.';return false}if(isMinor()&&!$('guardianAck').checked){$('err').textContent='Please acknowledge the guardian consent requirements.';return false}}if(step===4&&(!hasInk||!$('signed').checked)){$('err').textContent='Please sign and confirm your signature.';return false}return true}$('next').onclick=()=>{if(!valid())return;if(step<4){if(step===1)buildQuestions();step++;render()}else{window.submitConsentForm()}};$('back').onclick=()=>{step--;render()};const canvas=$('signature'),ctx=canvas.getContext('2d');ctx.lineWidth=4;ctx.lineCap='round';ctx.strokeStyle='#111';let drawing=false;function pos(e){const r=canvas.getBoundingClientRect();return{x:(e.clientX-r.left)*canvas.width/r.width,y:(e.clientY-r.top)*canvas.height/r.height}}canvas.addEventListener('pointerdown',e=>{drawing=true;canvas.setPointerCapture(e.pointerId);const p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y)});canvas.addEventListener('pointermove',e=>{if(!drawing)return;const p=pos(e);ctx.lineTo(p.x,p.y);ctx.stroke();hasInk=true});canvas.addEventListener('pointerup',()=>drawing=false);canvas.addEventListener('pointercancel',()=>drawing=false);$('clear').onclick=()=>{ctx.clearRect(0,0,canvas.width,canvas.height);hasInk=false};render();
</script>
<script type="module">
import {initializeApp} from 'https://www.gstatic.com/firebasejs/12.4.0/firebase-app.js';
import {getAuth,signInAnonymously,setPersistence,inMemoryPersistence} from 'https://www.gstatic.com/firebasejs/12.4.0/firebase-auth.js';
import {getFirestore,doc,setDoc,serverTimestamp} from 'https://www.gstatic.com/firebasejs/12.4.0/firebase-firestore.js';
import {getStorage,ref,uploadBytes} from 'https://www.gstatic.com/firebasejs/12.4.0/firebase-storage.js';
const config={apiKey:'AIzaSyCMukJqqHGwv8TO9gVxqxDiVnsV0Bzl4zk',authDomain:'waitlist-9cc98.firebaseapp.com',projectId:'waitlist-9cc98',storageBucket:'waitlist-9cc98.firebasestorage.app',messagingSenderId:'682598756147',appId:'1:682598756147:web:49b7fb8802e108fc075846',measurementId:'G-26X80FDKGV'};
const app=initializeApp(config,'consent-customer'),auth=getAuth(app),db=getFirestore(app),storage=getStorage(app);
let busy=false;
const el=id=>document.getElementById(id);
const val=id=>el(id).value.trim();
function failure(message){el('err').style.color='#a00000';el('err').textContent=message;el('next').disabled=false;busy=false;}
function fileType(file){return ['image/jpeg','image/png','image/webp'].includes(file.type)?file.type:null;}
async function put(uid,id,file){
  if(!file)return null;
  if(file.size>=10*1024*1024)throw new Error('Each uploaded file must be smaller than 10 MB.');
  const type=fileType(file);
  if(!type)throw new Error('Please upload a JPG, PNG, or WebP image.');
  const path=`consent-uploads/${uid}/${id}-${crypto.randomUUID()}.${type==='image/png'?'png':type==='image/webp'?'webp':'jpg'}`;
  await uploadBytes(ref(storage,path),file,{contentType:type});
  return path;
}
window.submitConsentForm=async()=>{
 if(busy)return;
 busy=true;el('next').disabled=true;el('err').style.color='#171717';el('err').textContent='Submitting securely. Please wait…';
 try{
   // Isolate customer authentication from the shop's existing waitlist/admin login.
   // Memory-only persistence avoids replacing any saved Google or waitlist session.
   await setPersistence(auth,inMemoryPersistence);
   let user=auth.currentUser;
   if(!user || !user.isAnonymous){const result=await signInAnonymously(auth);user=result.user;}
   const id=crypto.randomUUID();
   const signatureBlob=await new Promise(resolve=>el('signature').toBlob(resolve,'image/png'));
   if(!signatureBlob)throw new Error('Could not save signature. Please sign again.');
   const signaturePath=await put(user.uid,id,signatureBlob);
   const guardianIdPath=isMinor()?await put(user.uid,id,el('guardianId').files[0]):null;
   const relationshipDocPath=isMinor()&&el('relationshipDoc').files.length?await put(user.uid,id,el('relationshipDoc').files[0]):null;
   const answers=qs.map((question,i)=>({question,answer:document.querySelector(`input[name=q${i}]:checked`).value}));
   const record={ownerUid:user.uid,formVersion:'2026-11-02-v1',createdAt:serverTimestamp(),service:val('service'),fullName:val('fullName'),dob:val('dob'),phone:val('phone'),email:val('email'),address:val('address'),detail:val('detail'),minor:!!isMinor(),guardian:isMinor()?{name:val('guardianName'),relation:val('guardianRelation'),phone:val('guardianPhone'),address:val('guardianAddress'),work:val('guardianWork'),idType:val('guardianIdType'),present:el('guardianPresent').checked,idPath:guardianIdPath,relationshipDocPath}:null,answers,notes:val('notes'),photoRelease:document.querySelector('input[name=photoRelease]:checked').value,consentAgreed:el('agree').checked,designAgreed:val('service')==='Tattoo'?el('designAgree').checked:null,guardianAcknowledged:isMinor()?el('guardianAck').checked:null,marketingEmail:el('marketingEmail').checked,signatureConfirmed:el('signed').checked,signaturePath};
   await setDoc(doc(db,'consentForms',id),record);
   el('form').innerHTML='<h2>Consent submitted</h2><p>Thank you. Your form was received. Please see the front desk for identification verification and any required in-person guardian consent.</p><p class="muted">Submission reference: '+id+'</p>';
   el('statusBanner').textContent='Test submission received. Staff will review your form.';
 }catch(e){console.error(e);failure('Submission was not completed: '+(e.message||'Please try again.'));}
};
</script></body></html>
